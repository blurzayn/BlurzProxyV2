{
  "name": "BlurzProxy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "BlurzProxy",
      "onAutoForward": "notify",
      "visibility": "private",
      "protocol": "https"
    }
  },
  "postCreateCommand": "cd BlurzProxy && npm ci",
  "postStartCommand": "bash .devcontainer/start-proxy.sh",
  "containerEnv": {
    "HOST": "0.0.0.0"
  }
}
