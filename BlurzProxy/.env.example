# TEMPLATE ONLY — never put real credentials in this file.
# Copy to .env for local development. Production secrets belong in your
# hosting provider's secret/environment-variable manager, not GitHub.
ADMIN_PASSWORD=replace-with-a-random-secret-at-least-16-characters-long

# Exact browser origin(s), including scheme and non-default port.
# Separate multiple origins with commas; do not use wildcards or paths.
ALLOWED_ORIGINS=http://localhost:3000

# Local development only. Production requires HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false

# Set true only behind one trusted reverse proxy that overwrites forwarded
# client-IP headers. Do not enable this for direct access.
TRUST_PROXY=false
