# Copy this file to .env and replace the password with a unique secret.
# Never commit .env or real credentials.
ADMIN_PASSWORD=replace-with-a-random-secret-at-least-16-characters-long

# Exact browser origin(s), including scheme and non-default port.
# Separate multiple origins with commas; do not use wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# Local development only. Set true in production behind HTTPS.
COOKIE_SECURE=false

# Set true only when running behind one trusted reverse proxy that
# overwrites forwarded client-IP headers.
TRUST_PROXY=false
