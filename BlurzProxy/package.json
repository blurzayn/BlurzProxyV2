{
  "name": "blurzproxy",
  "version": "1.0.0",
  "description": "Private, authenticated browser application with restricted web transport.",
  "main": "index.js",
  "scripts": {
    "test": "node --test scripts/*.js",
    "test:e2e": "playwright test",
    "check": "node --check public/js/app.js && node --check server/index.js && bash -n ../.devcontainer/start-proxy.sh && npm test && npm run test:e2e",
    "start": "node server/index.js",
    "audit": "npm audit --audit-level=low",
    "start:codespaces": "bash ../.devcontainer/start-proxy.sh"
  },
  "keywords": [
    "authenticated-browser",
    "web-transport",
    "express",
    "scramjet",
    "security"
  ],
  "author": "BlurzProxy contributors",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "3.0.2",
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/wisp-js": "0.5.3",
    "@titaniumnetwork-dev/ultraviolet": "3.2.10",
    "@useinterstellar/scramjet": "1.1.0-fixed",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
